{
  "name": "miaoji",
  "version": "2.0.0",
  "private": true,
  "description": "秒记 — 桌面悬浮的跨领域术语记忆本：按学习方向解释、定期回顾，并写入 Obsidian",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "python tools/make_pixel_assets.py",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.miaoji.app",
    "productName": "秒记",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/@mozilla/readability/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "秒记",
      "artifactName": "miaoji-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  }
}
